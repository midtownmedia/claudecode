# ---- Server ----
PORT=8090
DATA_DIR=./data
PRACTICE_NAME="Midtown Veterinary"
PRACTICE_TZ=America/New_York
# Shared device token. Every phone enters it once in Settings. Leave empty to run open on a trusted LAN.
AUTH_TOKEN=

# ---- SOAP drafting (Claude) ----
# Leave ANTHROPIC_API_KEY empty and AI_PROVIDER=mock to demo without a key.
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic           # anthropic | mock
# Sonnet 5.5 is the default: accurate on doses and vitals, about 4-5 cents per full visit.
# claude-haiku-5-5 is roughly 20x cheaper and worth trialling on your own transcripts.
VETSCRIBE_MODEL=claude-sonnet-5-5
VETSCRIBE_EFFORT=medium         # low | medium | high. This is organisation work, not reasoning; medium is plenty.

# ---- Transcription (Whisper) ----
# openai   : POST the audio to an OpenAI-compatible /v1/audio/transcriptions endpoint.
#            OpenAI's hosted Whisper, Groq, or a whisper.cpp / faster-whisper server on
#            your own network all speak this. Self-hosting keeps audio inside the practice.
# browser  : the phone's live captions only (free; Google/Apple speech service).
# With TRANSCRIBE_API_KEY set the provider defaults to openai.
TRANSCRIBE_PROVIDER=openai
TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=en

# ---- Privacy ----
# Live captions on the phone send audio to the browser vendor's speech service.
# They default to off whenever Whisper is configured.
CAPTIONS=off
# Delete each recording as soon as it is transcribed (false), or keep it for review.
KEEP_AUDIO=true
# Kept recordings are deleted after this many days. Transcripts and notes stay.
AUDIO_RETENTION_DAYS=30

# ---- Practice management system ----
# mock     : a seeded day of appointments, for demos and tests
# daysmart : DaySmart Vet (Vetter). Defaults to daysmart when DAYSMART_API_KEY is set.
# bridge   : the HTTP contract in README.md, for any other system
PIMS_ADAPTER=mock
PIMS_BRIDGE_URL=http://localhost:9000
PIMS_BRIDGE_TOKEN=

# DaySmart Vet. Ask DaySmart for developer credentials (API key, client id,
# client secret, clinic id). Try the sandbox domain first, then production.
DAYSMART_DOMAIN=sandbox.vettersoftware.com
DAYSMART_API_KEY=
DAYSMART_CLIENT_ID=
DAYSMART_CLIENT_SECRET=
DAYSMART_CLINIC_ID=
# The reference says the clinic id goes in a request header but not its name.
DAYSMART_CLINIC_HEADER=x-clinic-id
DAYSMART_SCOPE=
# Optional: a path (relative to /api/1.0.0/{apiKey}/) that lists a patient's
# records, once the probe shows which one exists. {id} is the patient id.
DAYSMART_RECORDS_PATH=
# Optional: extra query string for the appointments list if a date filter exists,
# e.g. "start={date}&end={date}". Otherwise the day is selected client-side.
DAYSMART_SCHEDULE_QUERY=
# outbox        : save the finished note for pasting into Vetter (default)
# communication : also POST it as a communication entry on the client record
DAYSMART_NOTE_MODE=outbox
DAYSMART_COMMUNICATION_TYPE=2
